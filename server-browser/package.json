{
  "name": "server-browser",
  "private": true,
  "version": "0.13.3",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --require ./tests/text-loader.cjs --import ./tests/i18n-setup.ts --test tests/*.test.ts",
    "test:ui": "playwright test --config tests/playwright.config.mjs",
    "preview:build": "node scripts/preview.mjs",
    "test:agent": "node tests/live-agent-check.mjs",
    "test:ux": "node tests/live-ux-check.mjs",
    "test:agent-tabs": "node tests/live-agent-tabs-check.mjs",
    "test:typing": "node tests/live-typing-check.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3",
    "@getpaseo/client": "0.11.1",
    "@getpaseo/protocol": "0.11.1",
    "@types/node": "^22.20.3",
    "@playwright/test": "^1.63.0",
    "playwright-core": "1.63.0",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.2",
    "esbuild": "^0.28.2",
    "lucide-react": "1.47.0",
    "tsx": "^4.23.13"
  },
  "description": "Server Browser: a Chromium browser on the Paseo daemon host, shared by your devices and a browser Agent",
  "license": "MIT"
}
